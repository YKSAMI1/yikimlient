{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YIKIMLient",
  "version": "0.2.4",
  "identifier": "com.yikimlient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "YIKIMLient",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/.yikimlient/**/*", "$APPDATA/**/*", "**/.yikimlient/**/*"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage", "deb"],
    "resources": ["resources/mods/*"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "copyright": "© 2026 YIKIMLient",
    "shortDescription": "YIKIMLient — Hızlı Minecraft Launcher",
    "longDescription": "Ultra-hafif, ultra-hızlı Minecraft launcher ve oyun içi mod. Electron'suz, Tauri 2 + Rust ile oluşturuldu.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNDk2OUEzMTE4NThGNTIKUldSU2o0VVJvMmxKMFBEUjFLUnFUdHR4VS8wVFJ2Vi9IaFdjeS9VblNCTy9KVHViWmxNblhUV1kK",
      "endpoints": [
        "https://github.com/YKSAMI1/yikimlient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
