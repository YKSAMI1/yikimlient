# ==== YIKIMLient Güvenlik API — GİZLİ BİLGİLER (ASLA DEPOYA YAZILMAZ) ====
# Bu dosyayı kopyalayıp .env olarak kaydet; .env .gitignore'dadır.

# --- Veritabanı bağlantısı ---
# Yerel test: bir dosya yolu (depoya girmez, .gitignore zaten data/)
# Yayın (Cloudflare + Turso): Turso bağlantı dizesi — connection string BURADA,
# kodda asla sabit yazılmaz.
YIKIM_DB=C:/Users/USER/AppData/Roaming/.yikimlient/guvenlik-api/guvenlik.db

# --- Parola güvenliği ---
# scrypt/Argon2 türetirken kullanılan biber (en az 16 karakter, rastgele üret)
# Üret: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
YIKIM_PEPPER=<buraya-rastgele-24-bayt-koyun>

# Doğrulayıcının DB'de şifreli saklanması için anahtar (32 bayt: base64 veya hex)
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
YIKIM_ANAHTAR=<buraya-32-bayt-anahtar-koyun>

# --- Sunucu imzalama (launcher'da gömülü genel anahtar bu anahtardan türetilir) ---
# Ed25519 gizli anahtarı (32 bayt, hex ya da base64) — sadece API sürecinde durur.
# Üret: node -e "const c=require('crypto').generateKeyPairSync('ed25519');console.log(c.privateKey.export({format:'hex',type:'pkcs8'}).toString())"
YIKIM_IMZA_GIZLI=<buraya-ed25519-gizli-anahtar-koyun>

# --- Panel yöneticisi (Discord kullanıcı kimliği) ---
# Panel yalnızca bu ID ile giriş yapar; herkese açık değildir.
YIKIM_ADMIN_ID=1137682456783376467

# --- Sunucu ---
YIKIM_DINLE=127.0.0.1:8788

# --- Bot API anahtarı (bot ile API arasındaki çağrılar için) ---
# Bot istekleri sunucu imzası gerektirir; bu anahtar botun .env'sindedir.
YIKIM_BOT_ANAHTAR=<bot-ile-paylasilan-gizli-anahtar>
