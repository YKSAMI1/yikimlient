# === Yöntem 1: Düz token (basit) ===
TOKEN=buraya_discord_bot_tokeninizi_yazin

# === Yöntem 2: Şifreli token (önerilen) ===
# Önce: node scripts/encrypt-token.js çalıştırın
# TOKEN_ENCRYPTED=
# TOKEN_KEY=

# Sunucu ayarları (zorunlu)
GUILD_ID=1436397283057995938
CHANNEL_ID=1465760963843063078
ROLE_ID=1465760854526918703

# Güvenlik (isteğe bağlı)
EVENT_COOLDOWN_MS=5000
MAX_CONCURRENT_OPS=5

# === YIKIMLient güvenlik API bağlantısı (LAUNCHER İZNİ İÇİN ŞART) ===
# Bot rol verdiğinde/alınca bu bilgiyi API'ye yazar; launcher kozmetik kapısı
# (pelerin/elitra çizme) bu bilgiye bakar. Bu iki satır BOŞ ise API çağrısı
# yapılmaz — botun rol/mesaj sistemi normal çalışmaya devam eder, ama
# launcher'da kozmetik izni asla güncellenmez (etiket bıraksa bile açık kalır).
# API artık Cloudflare'de çalışıyor (kimsenin bilgisayarında değil) — bu adres sabit.
YIKIM_API=https://yikimlient.vercel.app
# API ile paylaşılan gizli anahtar (Cloudflare Worker'daki YIKIM_BOT_ANAHTARI ile BİREBİR aynı olmalı)
YIKIM_BOT_ANAHTARI=buraya_api_ile_ayni_gizli_anahtar

# === YIKIMLient güvenlik API bağlantısı ===
# Yerel geliştirme/test: npx wrangler dev → http://127.0.0.1:8788
YIKIM_API=https://yikimlient.vercel.app
# API ile paylaşılan gizli anahtar (guvenlik-api/.env.example → YIKIM_BOT_ANAHTARI)
YIKIM_BOT_ANAHTARI=buraya_api_ile_ayni_gizli_anahtar

# "Yol Silindiri" rolü (bu role sahip kullanıcılar kendi pelerin/elitrasını çizebilir)
ROLE_YOL_ID=1465760854526918703

# Duyuru alıcısı: sahibin Discord kullanıcı ID'si (panel/duyuru hedefi)
YIKIM_ADMIN_ID=1137682456783376467

# 0 = duyuru yalnız sahibe, 1 = "Yol Silindiri" rolü olan herkese
YIKIM_DM_ROLE=0
